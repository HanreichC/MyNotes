{
  "name": "mynotes",
  "productName": "MyNotes",
  "version": "0.1.0",
  "description": "Notizeditor mit Tabs, Wiki-Navigation und Live-Markdown, der nichts verliert",
  "author": "Chris",
  "private": true,
  "type": "module",
  "main": "src/main/boot.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "test": "node --test tests/*.test.js",
    "e2e": "node build.mjs && node tests/e2e.mjs",
    "dist": "node build.mjs && electron-builder"
  },
  "build": {
    "appId": "de.hanreich.mynotes",
    "files": [
      "src/main/**",
      "src/shared/**",
      "dist/**",
      "!dist/**/*.map"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "pacman"
      ],
      "category": "Office",
      "maintainer": "Chris"
    },
    "icon": "build/icon.png",
    "publish": null,
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "at-spi2-core",
        "libxss",
        "libxtst",
        "xdg-utils"
      ]
    }
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-code-block-lowlight": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-paragraph": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/markdown": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "codemirror": "6.0.2",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "lowlight": "3.3.0",
    "marked": "17.0.6",
    "playwright-core": "1.64.1"
  },
  "desktopName": "mynotes.desktop"
}
